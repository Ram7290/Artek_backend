# ── Database ──────────────────────────────────────────────────────────────
# Local Postgres (PostgreSQL 18 on this machine).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artek_website

# ── HTTP ──────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of frontend origins allowed to POST enquiries.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Email notification ─────────────────────────────────────────────────────
# Leave SMTP_* unset to run in "log only" mode: the lead is still saved to
# Postgres, but no email is sent and a line is printed instead. Never fakes.
# For ARTEK production use Microsoft 365 SMTP:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=info@artekteam.com
#   SMTP_PASS=...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Artek Website <noreply@artekteam.com>
MAIL_TO=info@artekteam.com,sales@artekteam.com

# ── Admin auth ────────────────────────────────────────────────────────────
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
