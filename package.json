{
  "name": "artek-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ARTEK Computers LLC — enquiry API (Express + Sequelize + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "db:create": "node db/scripts/create-db.js",
    "db:sync": "node db/scripts/sync.js",
    "db:sync:alter": "node db/scripts/sync.js --alter",
    "admin:create": "node db/scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sanitize-html": "^2.18.2",
    "sequelize": "^6.37.5",
    "zod": "^3.24.2"
  }
